# =============================================================================
# 本機開發：複製為 .env.local 並填值（.env.local 不會提交到 Git）
# Vercel：到專案 → Settings → Environment Variables 新增「相同變數名稱」
#        建議 Production / Preview 都勾選，儲存後要 Redeploy 才會套用
# =============================================================================

# Supabase（Dashboard → Project Settings → API）
NEXT_PUBLIC_SUPABASE_URL=
# 若前端未直接使用可留空；與 Dashboard「anon public」相同
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 僅伺服端（Route Handler / API）使用，勿設為 NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin：Google OAuth（Auth.js / next-auth）---
# 產生方式：openssl rand -base64 32
AUTH_SECRET=
# 正式站完整 URL，例如 https://your-domain.vercel.app（勿尾隨斜線）
AUTH_URL=
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs（網頁應用程式）
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# 可登入後台的 Google 帳號 email，逗號分隔、全小寫比對
ADMIN_EMAIL_ALLOWLIST=

# 結帳 UK 郵遞區號建議：伺服端轉發 postcodes.io，無需額外 API Key
# 完整門牌地址選單（選單選址）：getAddress.io 申請後填入（https://getaddress.io）
# GETADDRESS_API_KEY=
