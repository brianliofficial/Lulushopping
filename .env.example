# =============================================================================
# 本機開發：複製為 .env.local 並填值（.env.local 不會提交到 Git）
# Vercel：到專案 → Settings → Environment Variables 新增「相同變數名稱」
#        建議 Production / Preview 都勾選，儲存後要 Redeploy 才會套用
# =============================================================================

# Supabase（Dashboard → Project Settings → API）
NEXT_PUBLIC_SUPABASE_URL=
# 若前端未直接使用可留空；與 Dashboard「anon public」相同
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 僅伺服端（Route Handler / API）使用，勿設為 NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# 正式環境（非 development）：後台 API 與管理頁需帶 Authorization: Bearer 此密碼
PRODUCTS_ADMIN_SECRET=
